{
  "name": "mcpflow-router",
  "version": "0.3.3",
  "description": "MCP tool router with smart-search and on-demand loading",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcpflow-router": "dist/index.js"
  },
  "files": [
    "dist",
    "mcp-server/mcp_tool_router/*.py",
    "mcp-server/pyproject.toml",
    "mcp-server/README.md"
  ],
  "scripts": {
    "build": "tsc",
    "postinstall": "node dist/postinstall.js 2>/dev/null || true"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "router",
    "bm25",
    "tool-routing",
    "opencode",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/effortprogrammer/mcpflow-router.git"
  },
  "bugs": {
    "url": "https://github.com/effortprogrammer/mcpflow-router/issues"
  },
  "homepage": "https://github.com/effortprogrammer/mcpflow-router#readme",
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.4.5"
  }
}
